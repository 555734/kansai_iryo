{
  "manifest_version": 2,
  "name": "TriAI Unified Extractor",
  "version": "1.0.0",
  "description": "Reads the currently open AI conversations and forwards normalized snapshots to the TriAI app.",
  "browser_specific_settings": {
    "gecko": {
      "id": "triai-unified@local"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*"
  ]
}
